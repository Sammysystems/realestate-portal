# Environment template — copy to .env.local and fill in.
#
# .env.local is git-ignored and must never be committed. Every value here is a
# PLACEHOLDER. If you paste a real key into THIS file it will be published.
# Put real values in .env.local only.

# --- InsForge (shared Postgres backend) ------------------------------------
INSFORGE_URL="https://YOUR-PROJECT.us-east.insforge.app"
INSFORGE_API_KEY="SERVER_SIDE_KEY_GOES_HERE"

# --- Outbound email (SMTP via Resend, shared) -------------------------------
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="SERVER_SIDE_LOGIN_GOES_HERE"
SMTP_PASS="SERVER_SIDE_KEY_GOES_HERE"
EMAIL_FROM="ops@yourdomain.com"

# Demo convenience: every dispatch is BCC'd here so the owner sees all sends
# even when a visitor enters a fake email. Optional.
REP_DEMO_INBOX="owner@yourdomain.com"

# --- OpenRouter (optional AI polish layer — deterministic fallback always) --
OPENROUTER_API_KEY="SERVER_SIDE_KEY_GOES_HERE"
OPENROUTER_CHAT_MODEL="SERVER_SIDE_MODEL_ID_GOES_HERE"

# --- Admin access -----------------------------------------------------------
# Required to open the dashboard / run actions / seed the demo.
REP_ADMIN_TOKEN="long-random-string"

# --- Behavior ---------------------------------------------------------------
SEED_ENABLED="false"
APP_URL="https://your-site.vercel.app"